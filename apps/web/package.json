{
  "name": "@squillpad/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --reporter=minimal --silent=passed-only --hideSkippedTests",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@squillpad/core-model": "workspace:*",
    "@squillpad/synchronization": "workspace:*",
    "@squillpad/ui": "workspace:*",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vitest": "4.1.11"
  }
}
